[Unit]
Description=CONTROLFORGE API (FastAPI/uvicorn on @API_BIND@:@API_PORT@)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=exec
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_DIR@/backend
EnvironmentFile=@CONF_DIR@/controlforge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m uvicorn app.main:app --host @API_BIND@ --port @API_PORT@

Restart=on-failure
RestartSec=3

# --- hardening -------------------------------------------------------------
# ProtectHome=read-only (not =yes): the application code and venv usually live
# under /home or /root, and the unit must still be able to read them. Read-only
# is enough - the API never writes to its own source tree.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@ @LOG_DIR@
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictNamespaces=yes
PrivateDevices=yes
# KillMode=mixed: SIGTERM to the main process only, then SIGKILL to whatever
# is left in the cgroup - a stray child cannot survive a stop/restart.
KillMode=mixed

[Install]
WantedBy=multi-user.target
